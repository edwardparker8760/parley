# Parley environment. Copy to .env and fill in. NEVER commit .env.
# Missing keys is a legal state: it selects the local stub settlement adapter
# rather than crashing, so the negotiation engine runs without any credentials.

# --- Wallets (Arc TESTNET only) ---
# Generate with `pnpm provision-wallets`, then fund the addresses at
# https://faucet.circle.com (select Arc Testnet, roughly 1 USDC/day).
#
# These are what real settlement actually needs. GatewayClient authenticates
# with a raw EVM private key via viem, NOT with a Circle API key.
# See docs/x402-sdk-verified-surface.md.
#
# TESTNET KEYS ONLY. Never put a mainnet key in this repo.
BUYER_WALLET_ADDRESS=
BUYER_PRIVATE_KEY=
SELLER_WALLET_ADDRESS=
SELLER_PRIVATE_KEY=
SELLER_PAYOUT_WALLET_ADDRESS=
SELLER_PAYOUT_PRIVATE_KEY=

# --- Settlement ---
# local-stub (default, no credentials needed) | arc-x402 (needs the keys above)
SETTLEMENT_MODE=local-stub
# Artificial latency for the stub, in ms, so pending -> settled is visible.
SETTLEMENT_STUB_LATENCY_MS=800

# --- Circle Developer-Controlled Wallets (OPTIONAL) ---
# Not required by anything in the critical path. The x402 batching SDK does not
# use these. Kept only for an optional custodial wallet story.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# --- LLM layer (phase 05) ---
# off            deterministic pick, templated rationale. No API calls. Tests
#                and the full test suite run in this mode: fast, free, exact.
# rationale-only LLM writes the sentence; arithmetic still picks the number.
# full           LLM picks inside the already-computed band, and writes the
#                sentence. The clamp still re-validates afterwards.
# replay         reads a recorded tape instead of calling the API. Use this for
#                the demo video so the recording cannot be ruined by a slow or
#                unavailable model on the day.
LLM_MODE=off
LLM_API_KEY=
LLM_MODEL=claude-opus-5
# Hard per-call timeout. On expiry the deterministic pick is used instead.
LLM_TIMEOUT_MS=4000
# Tape used by LLM_MODE=replay.
LLM_TAPE_PATH=docs/llm-tape.json
